# Copiez ce fichier en .env et remplissez les valeurs (Supabase > Project Settings > API).
# Ne mettez JAMAIS de clé secrète (service_role) dans un fichier VITE_ : elle serait visible par tout le monde.
SUPABASE_PROJECT_ID=
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
VITE_SUPABASE_PROJECT_ID=
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=

# --- Envoi des codes de vérification par email (côté serveur uniquement) ---
# Ces trois valeurs se règlent dans les « Secrets » de Lovable Cloud, JAMAIS dans un fichier publié sur GitHub.
# EMAIL_PROVIDER : brevo (par défaut) ou resend
# EMAIL_API_KEY  : clé API du service d'envoi d'emails
# EMAIL_FROM     : adresse d'expéditeur validée chez le service (ex. verification@votredomaine.com)
EMAIL_PROVIDER=
EMAIL_API_KEY=
EMAIL_FROM=
